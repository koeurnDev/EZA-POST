generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  free
  pro
}

enum UserRole {
  user
  admin
  demo
}

enum PostStatus {
  draft
  scheduled
  processing
  published
  failed
  expired
  cancelled
}

enum MediaType {
  video
  image
  carousel
}

enum BotRuleType {
  KEYWORD
  REGEX
}

enum BotRuleScope {
  ALL
  SPECIFIC
}

enum ReplyStatus {
  pending
  processing
  failed
  completed
}

enum BoostCampaignStatus {
  draft
  active
  paused
  completed
  failed
}

enum BoostAccountStatus {
  active
  banned
  cooldown
  error
}

enum PlatformName {
  facebook
  tiktok
  youtube
  instagram
}

enum CreditTransactionType {
  purchase
  spend
  refund
  bonus
}

model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  password              String
  name                  String              @default("User")
  plan                  UserPlan            @default(free)
  role                  UserRole            @default(user)
  lastLogin             DateTime?
  avatar                String?
  coverImage            String?

  facebookId            String?             @unique
  facebookName          String?
  facebookAccessToken   String?
  facebookTokenExpiresAt DateTime?

  twoFactorSecret       String?
  twoFactorEnabled      Boolean             @default(false)
  twoFactorVerified     Boolean             @default(false)

  credits               Int                 @default(0)
  totalCreditsSpent     Int                 @default(0)
  totalCreditsPurchased Int                 @default(0)
  pageSettings          Json?               @default("[]")

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  facebookPages         FacebookPage[]
  scheduledPosts        ScheduledPost[]
  botRules              BotRule[]
  botStatus             BotStatus?
  botHistory            BotHistory[]
  pendingReplies        PendingReply[]
  repliedComments       RepliedComment[]
  postMetrics           PostMetrics[]
  boostCampaigns        BoostCampaign[]
  boostAccounts         BoostAccount[]
  creditTransactions    CreditTransaction[]
  platformConfigs       PlatformConfig[]
  botMonitoredPosts     BotMonitoredPost[]

  @@map("users")
}

model FacebookPage {
  id             String          @id
  userId         String
  name           String
  category       String?
  picture        String?
  followersCount Int?            @default(0)
  accessToken    String?
  isConnected    Boolean         @default(true)
  isSelected     Boolean         @default(false)
  enableSchedule Boolean         @default(true)
  enableBot      Boolean         @default(false)
  enableInbox    Boolean         @default(false)
  lastSync       DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  targets        PostTarget[]
  pendingReplies PendingReply[]
  botRules       BotRule[]
  monitoredPosts BotMonitoredPost[]
  metrics        PostMetrics[]

  @@index([userId])
  @@index([isConnected])
  @@map("facebook_pages")
}

model ScheduledPost {
  id           String         @id @default(uuid())
  userId       String
  caption      String
  postType     MediaType      @default(video)
  status       PostStatus     @default(scheduled)
  scheduleTime DateTime
  postedAt     DateTime?
  attempts     Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id])
  mediaItems   ScheduledMedia[]
  targets      PostTarget[]

  @@index([status, scheduleTime])
  @@index([userId, status])
  @@map("scheduled_posts")
}

model ScheduledMedia {
  id              String        @id @default(uuid())
  scheduledPostId String
  url             String
  publicId        String?
  mediaType       MediaType
  position        Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id])

  @@index([scheduledPostId])
  @@map("scheduled_media")
}

model PostTarget {
  id              String      @id @default(uuid())
  scheduledPostId String
  pageId          String
  status          PostStatus  @default(scheduled)
  facebookPostId  String?     @unique
  error           String?
  postedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id])
  page            FacebookPage  @relation(fields: [pageId], references: [id])
  metrics         PostMetrics?
  botRules        BotRule[]
  boostCampaigns  BoostCampaign[]

  @@unique([scheduledPostId, pageId])
  @@index([status, pageId])
  @@map("post_targets")
}

model PostMetrics {
  id             String       @id @default(uuid())
  postTargetId   String       @unique
  pageId         String
  userId         String
  likes          Int          @default(0)
  comments       Int          @default(0)
  shares         Int          @default(0)
  reactions      Json         @default("{}")
  reach          Int          @default(0)
  impressions    Int          @default(0)
  engagement     Int          @default(0)
  viralScore     Int          @default(0)
  viralTier      String       @default("low")
  lastSyncedAt   DateTime?    @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  postTarget     PostTarget   @relation(fields: [postTargetId], references: [id])
  page           FacebookPage @relation(fields: [pageId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([userId, viralScore])
  @@index([pageId])
  @@map("post_metrics")
}

model BotRule {
  id                String        @id @default(uuid())
  userId            String
  pageId            String?
  scheduledTargetId String?
  keyword           String
  reply             String
  attachmentUrl     String?
  ruleType          BotRuleType   @default(KEYWORD)
  scope             BotRuleScope  @default(ALL)
  enabled           Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  page              FacebookPage? @relation(fields: [pageId], references: [id])
  scheduledTarget   PostTarget?   @relation(fields: [scheduledTargetId], references: [id])

  @@index([userId, enabled])
  @@map("bot_rules")
}

model BotStatus {
  id           String   @id @default(uuid())
  userId       String   @unique
  enabled      Boolean  @default(true)
  lastRun      DateTime?
  totalReplies Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])

  @@map("bot_status")
}

model BotHistory {
  id           String   @id @default(uuid())
  userId       String
  commentId    String
  replyMessage String
  pageName     String?
  pageId       String?
  status       String
  error        String?
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("bot_history")
}

model PendingReply {
  id                String      @id @default(uuid())
  userId            String
  pageId            String
  facebookCommentId String      @unique
  facebookPostId    String
  replyMessage      String
  attachmentUrl     String?
  accessToken       String
  sendAt            DateTime
  status            ReplyStatus @default(pending)
  attempts          Int         @default(0)
  error             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id])
  page              FacebookPage @relation(fields: [pageId], references: [id])

  @@index([status, sendAt, userId])
  @@map("pending_replies")
}

model RepliedComment {
  id                String   @id @default(uuid())
  facebookCommentId String   @unique
  facebookPostId    String
  userId            String
  repliedAt         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id])

  @@index([userId, facebookPostId])
  @@map("replied_comments")
}

model BoostCampaign {
  id             String             @id @default(uuid())
  userId         String
  postTargetId   String?
  pageId         String
  campaignId     String?            @unique
  adSetId        String?
  adId           String?
  budget         Float
  duration       Int
  startDate      DateTime
  endDate        DateTime
  targeting      Json               @default("{}")
  status         BoostCampaignStatus @default(draft)
  metrics        Json               @default("{}")
  error          String?
  lastSyncedAt   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User               @relation(fields: [userId], references: [id])
  postTarget     PostTarget?        @relation(fields: [postTargetId], references: [id])

  @@index([userId, status, pageId])
  @@map("boost_campaigns")
}

model BoostAccount {
  id                String            @id @default(uuid())
  userId            String
  platform          PlatformName
  username          String
  encryptedPassword String?
  cookies           Json              @default("[]")
  cookiesUpdated    DateTime?         @default(now())
  status            BoostAccountStatus @default(active)
  lastUsed          DateTime?
  totalActions      Int               @default(0)
  dailyLimit        Int               @default(25)
  actionsToday      Int               @default(0)
  lastResetDate     DateTime?         @default(now())
  cooldownUntil     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id])

  @@index([userId, platform, status])
  @@map("boost_accounts")
}

model CreditPackage {
  id        String   @id @default(uuid())
  name      String
  credits   Int
  price     Float
  priceKHR  Float    @map("price_khr")
  discount  Float    @default(0)
  popular   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_packages")
}

model CreditTransaction {
  id          String                 @id @default(uuid())
  userId      String
  type        CreditTransactionType
  amount      Int
  balance     Int
  description String?
  relatedId   String?                @map("related_id")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user        User                   @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model PlatformConfig {
  id           String       @id @default(uuid())
  userId       String
  platform     PlatformName
  isEnabled    Boolean      @default(true) @map("is_enabled")
  accessToken  String?
  refreshToken String?
  externalId   String?
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, platform])
  @@map("platform_configs")
}

model BotMonitoredPost {
  id              String       @id @default(uuid())
  userId          String
  pageId          String
  facebookPostId  String
  enabled         Boolean      @default(true)
  lastChecked     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id])
  page            FacebookPage @relation(fields: [pageId], references: [id])

  @@unique([userId, facebookPostId])
  @@index([pageId, enabled])
  @@map("bot_monitored_posts")
}
