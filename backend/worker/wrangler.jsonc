{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eza-post-api",
	"account_id": "f6004fb8e0ca2a70515fa76d694e4cad",
	"main": "src/index.js",
	"compatibility_date": "2026-10-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": [
				"**/*.wasm"
			],
			"fallthrough": true
		}
	],
	"workers_dev": true,
	"placement": {
		"mode": "smart"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "GEMINI_PROXY",
				"class_name": "GeminiProxyDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GeminiProxyDO"
			]
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "khmersub-media",
			"preview_bucket_name": "khmersub-media-dev"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "khmersub_db",
			"database_id": "7ac481f9-ec56-456b-9049-523c032b1dad"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"JWT_SECRET": "97b4f3e2d8c1a5b6e0d9c0f8a7e2b1d3c4b5a6f2e8d3c5b9a7f1e2d8c3b5a79f",
		"ENCRYPTION_KEY": "24d2713bad9e902a64c48970868f0a07",
		"SECURITY_PEPPER": "ezapost-security-pepper-2026",
		"FRONTEND_URL": "https://eza-post-3kv.pages.dev",
		"DATABASE_URL": "postgresql://neondb_owner:npg_P9irZ3EpVncx@ep-bold-king-ah26thpo-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require",
		"TELEGRAM_BOT_TOKEN": "8289587681:AAFLIUkaDdTN6yub83ezSctYpVNOR7ZCpyU",
		"TELEGRAM_BOT_USERNAME": "eza_ocr_bot",
		"BAKONG_ACCOUNT_ID": "seab_koeurn@bkrt",
		"BAKONG_MERCHANT_NAME": "EZA POST",
		"WHISPER_EDGE_MODEL": "@cf/openai/whisper-large-v3-turbo",
		"MAX_UPLOAD_MB": "150",
		"UPSTASH_REDIS_REST_URL": "https://sharp-newt-86747.upstash.io",
		"UPSTASH_REDIS_REST_TOKEN": "gQAAAAAAAVLbAAIgcDJkYjI0ODY4NWY4MTY0ODcyOTA1MjkxMTA1Y2JkMjJiMg"
	}
}
